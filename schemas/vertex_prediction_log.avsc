{
  "type": "record",
  "name": "VertexPredictionLog",
  "namespace": "com.bumble.avro.ml.vertex",
  "doc": "Public schema for Vertex AI online prediction logs delivered to Snowflake and downstream analytics systems.",
  "x-meta": {
    "ops_impact": "medium",
    "data_value": "high",
    "jira": "ML-123",
    "owners": {
      "team_email": "ml-platform@team.bumble.com"
    },
    "life_cycle": {
      "renew_by": "2026-12-31"
    },
    "schema_registry": {
      "compatibility": "backward"
    },
    "data_lake": {
      "retention_days": 365
    },
    "capacity_planning": {
      "doc": "Capacity estimates (not quotas or limits, for planning and monitoring/alerting). Replace -1 placeholders with your best current estimates.",
      "avg_event_bytes": -1,
      "max_event_bytes": -1,
      "avg_events_per_day": -1,
      "max_events_per_second": -1
    }
  },
  "fields": [
    {
      "name": "id",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Unique event identifier."
    },
    {
      "name": "ts",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Canonical event timestamp in milliseconds since epoch."
    },
    {
      "name": "insert_time",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Timestamp when the event was inserted into the streaming pipeline."
    },
    {
      "name": "event_time",
      "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
      "default": null,
      "doc": "Original source event timestamp when available."
    },
    {
      "name": "log_name",
      "type": "string",
      "doc": "Cloud Logging log name or upstream log stream name."
    },
    {
      "name": "resource_type",
      "type": "string",
      "doc": "GCP monitored resource type associated with the log event."
    },
    {
      "name": "resource_labels",
      "type": { "type": "map", "values": "string" },
      "default": {},
      "doc": "Resource label key-value pairs associated with the monitored resource."
    },
    {
      "name": "project_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "GCP project identifier for the source event."
    },
    {
      "name": "location",
      "type": ["null", "string"],
      "default": null,
      "doc": "Cloud region where the event originated."
    },
    {
      "name": "endpoint_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Vertex AI endpoint identifier associated with the log."
    },
    {
      "name": "model_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Model identifier associated with the event."
    },
    {
      "name": "model_version",
      "type": ["null", "string"],
      "default": null,
      "doc": "Model version associated with the event."
    },
    {
      "name": "severity",
      "type": "string",
      "doc": "Severity level of the log message."
    },
    {
      "name": "trace",
      "type": ["null", "string"],
      "default": null,
      "doc": "Distributed trace identifier when available."
    },
    {
      "name": "span_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Distributed tracing span identifier when available."
    },
    {
      "name": "insert_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Source log insert identifier when available."
    },
    {
      "name": "payload",
      "doc": "Prediction-specific payload containing request and response metadata.",
      "type": {
        "type": "record",
        "name": "PredictionPayload",
        "doc": "Nested prediction payload for inference metadata and serialized request-response content.",
        "fields": [
          {
            "name": "method",
            "type": ["null", "string"],
            "default": null,
            "doc": "Prediction method invoked, such as predict or rawPredict."
          },
          {
            "name": "deployed_model_id",
            "type": ["null", "string"],
            "default": null,
            "doc": "Identifier of the deployed model serving the request."
          },
          {
            "name": "latency_ms",
            "type": ["null", "long"],
            "default": null,
            "doc": "Prediction latency in milliseconds."
          },
          {
            "name": "status_code",
            "type": ["null", "int"],
            "default": null,
            "doc": "HTTP or service status code returned by the prediction request."
          },
          {
            "name": "request_size_bytes",
            "type": ["null", "long"],
            "default": null,
            "doc": "Serialized request size in bytes."
          },
          {
            "name": "response_size_bytes",
            "type": ["null", "long"],
            "default": null,
            "doc": "Serialized response size in bytes."
          },
          {
            "name": "request_payload_json",
            "type": ["null", "string"],
            "default": null,
            "doc": "Serialized request payload JSON. May contain user-linked data depending on the upstream model contract."
          },
          {
            "name": "response_payload_json",
            "type": ["null", "string"],
            "default": null,
            "doc": "Serialized response payload JSON returned by the model."
          },
          {
            "name": "error_message",
            "type": ["null", "string"],
            "default": null,
            "doc": "Human-readable error details when prediction processing fails."
          }
        ]
      }
    },
    {
      "name": "raw_payload_json",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional raw source payload preserved for troubleshooting and replay."
    }
  ]
}
