{
  "type": "record",
  "name": "VertexBatchLog",
  "namespace": "com.bumble.avro.ml.vertex",
  "doc": "Public schema for Vertex AI batch prediction job logs delivered to Snowflake and downstream analytics systems.",
  "x-meta": {
    "ops_impact": "medium",
    "data_value": "high",
    "jira": "ML-123",
    "owners": {
      "team_email": "ml-platform@team.bumble.com"
    },
    "life_cycle": {
      "renew_by": "2026-12-31"
    },
    "schema_registry": {
      "compatibility": "backward"
    },
    "data_lake": {
      "retention_days": 365
    },
    "capacity_planning": {
      "doc": "Capacity estimates (not quotas or limits, for planning and monitoring/alerting). Replace -1 placeholders with your best current estimates.",
      "avg_event_bytes": -1,
      "max_event_bytes": -1,
      "avg_events_per_day": -1,
      "max_events_per_second": -1
    }
  },
  "fields": [
    {
      "name": "id",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Unique event identifier."
    },
    {
      "name": "ts",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Canonical event timestamp in milliseconds since epoch."
    },
    {
      "name": "insert_time",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Timestamp when the event was inserted into the streaming pipeline."
    },
    {
      "name": "event_time",
      "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
      "default": null,
      "doc": "Original source event timestamp when available."
    },
    {
      "name": "log_name",
      "type": "string",
      "doc": "Cloud Logging log name or upstream log stream name."
    },
    {
      "name": "resource_type",
      "type": "string",
      "doc": "GCP monitored resource type associated with the log event."
    },
    {
      "name": "resource_labels",
      "type": { "type": "map", "values": "string" },
      "default": {},
      "doc": "Resource label key-value pairs associated with the monitored resource."
    },
    {
      "name": "project_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "GCP project identifier for the source event."
    },
    {
      "name": "location",
      "type": ["null", "string"],
      "default": null,
      "doc": "Cloud region where the event originated."
    },
    {
      "name": "endpoint_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Vertex AI endpoint identifier associated with the log."
    },
    {
      "name": "model_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Model identifier associated with the event."
    },
    {
      "name": "model_version",
      "type": ["null", "string"],
      "default": null,
      "doc": "Model version associated with the event."
    },
    {
      "name": "severity",
      "type": "string",
      "doc": "Severity level of the log message."
    },
    {
      "name": "trace",
      "type": ["null", "string"],
      "default": null,
      "doc": "Distributed trace identifier when available."
    },
    {
      "name": "span_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Distributed tracing span identifier when available."
    },
    {
      "name": "insert_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Source log insert identifier when available."
    },
    {
      "name": "payload",
      "doc": "Batch prediction payload describing job lifecycle, input, output, and result counts.",
      "type": {
        "type": "record",
        "name": "BatchPayload",
        "doc": "Nested batch prediction payload.",
        "fields": [
          {
            "name": "batch_job_id",
            "type": ["null", "string"],
            "default": null,
            "doc": "Batch prediction job identifier."
          },
          {
            "name": "batch_job_name",
            "type": ["null", "string"],
            "default": null,
            "doc": "Human-readable batch prediction job name."
          },
          {
            "name": "job_state",
            "type": ["null", "string"],
            "default": null,
            "doc": "Current or terminal state of the batch prediction job."
          },
          {
            "name": "input_uri",
            "type": ["null", "string"],
            "default": null,
            "doc": "Input dataset URI used by the batch prediction job."
          },
          {
            "name": "input_format",
            "type": ["null", "string"],
            "default": null,
            "doc": "Input data format used for batch prediction."
          },
          {
            "name": "output_uri",
            "type": ["null", "string"],
            "default": null,
            "doc": "Output dataset URI written by the batch prediction job."
          },
          {
            "name": "output_format",
            "type": ["null", "string"],
            "default": null,
            "doc": "Output data format produced by batch prediction."
          },
          {
            "name": "instance_count",
            "type": ["null", "long"],
            "default": null,
            "doc": "Total number of instances processed by the job."
          },
          {
            "name": "success_count",
            "type": ["null", "long"],
            "default": null,
            "doc": "Number of successfully processed instances."
          },
          {
            "name": "failure_count",
            "type": ["null", "long"],
            "default": null,
            "doc": "Number of failed instances."
          },
          {
            "name": "create_time",
            "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
            "default": null,
            "doc": "Timestamp when the batch prediction job was created."
          },
          {
            "name": "start_time",
            "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
            "default": null,
            "doc": "Timestamp when the batch prediction job started."
          },
          {
            "name": "end_time",
            "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
            "default": null,
            "doc": "Timestamp when the batch prediction job finished."
          },
          {
            "name": "error_code",
            "type": ["null", "string"],
            "default": null,
            "doc": "Machine-readable error code for the batch prediction job."
          },
          {
            "name": "error_message",
            "type": ["null", "string"],
            "default": null,
            "doc": "Human-readable batch prediction error message."
          }
        ]
      }
    },
    {
      "name": "raw_payload_json",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional raw source payload preserved for troubleshooting and replay."
    }
  ]
}
